# Copy to .env (gitignored) and fill in one key.
# Live reply drafting is optional; without a key the app uses deterministic persona drafts.

# Google Gemini (default provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Or an OpenAI-compatible endpoint (used only when GEMINI_API_KEY is empty)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Server
# PORT=4173
# HOST=127.0.0.1
